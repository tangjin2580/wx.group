<?xml version="1.0" encoding="utf-8"?>
<!-- 按下抬升：200ms（180–250ms 区间）从 1.5dp 抬到 5dp，松手回落。
     哪些视图挂这个动画由布局的 android:stateListAnimator 决定；
     系统开了「减少动效」时 SettingsActivity 会把 animator 摘掉。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="@integer/wg_motion_ms"
                android:propertyName="translationZ"
                android:valueFrom="@dimen/wg_elevation_card"
                android:valueTo="@dimen/wg_elevation_card_pressed"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="@integer/wg_motion_ms"
                android:propertyName="translationZ"
                android:valueFrom="@dimen/wg_elevation_card_pressed"
                android:valueTo="@dimen/wg_elevation_card"
                android:valueType="floatType" />
        </set>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- 外观与主题：模式切换 / 主题卡片（含群组预览）/ 单组配色。
     主题卡片与分组行是动态构建的（颜色随主题变），这里只放骨架容器。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wg_page_bg"
    android:orientation="vertical">

    <!-- 顶部应用栏（自带，主题为 NoActionBar） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/wg_top_bar_h"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="@dimen/wg_content_side">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="‹"
            android:textColor="@color/wg_text_primary"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/WgTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_theme_hint"
                style="@style/WgRowSub"
                android:layout_marginTop="2dp"
                android:text="@string/theme_hint" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="@dimen/wg_content_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/wg_content_side"
            android:paddingEnd="@dimen/wg_content_side">

            <!-- ══ 深浅色模式 ══ -->
            <TextView
                style="@style/WgSectionLabel"
                android:text="@string/theme_mode_title" />

            <LinearLayout style="@style/WgCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <Button
                        android:id="@+id/btn_mode_system"
                        style="@style/WgButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:minHeight="44dp"
                        android:text="@string/theme_mode_system"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_mode_light"
                        style="@style/WgButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:minHeight="44dp"
                        android:text="@string/theme_mode_light"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_mode_dark"
                        style="@style/WgButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="44dp"
                        android:text="@string/theme_mode_dark"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══ 主题卡片（代码填充）══ -->
            <TextView
                style="@style/WgSectionLabel"
                android:text="@string/theme_list_title" />

            <!-- 当前效果：切主题时在这儿做 240ms 颜色过渡 -->
            <LinearLayout
                android:id="@+id/ll_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/ll_themes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_reset_theme"
                style="@style/WgButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/theme_reset" />

            <!-- ══ 单组配色（代码填充）══ -->
            <TextView
                style="@style/WgSectionLabel"
                android:text="@string/theme_group_title" />

            <LinearLayout
                android:id="@+id/ll_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_groups_empty"
                style="@style/WgRowSub"
                android:layout_marginTop="4dp"
                android:text="@string/theme_group_empty"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

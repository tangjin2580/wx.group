<?xml version="1.0" encoding="utf-8"?>
<!-- 普通卡片：纯色 + 圆角 + 1dp 描边（深色下描边才让卡片从背景里浮出来） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/wg_surface" />
    <corners android:radius="@dimen/wg_radius_card" />
    <stroke
        android:width="1dp"
        android:color="@color/wg_border" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 检查更新需要联网拉取 GitHub Releases -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".WxGroupApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_sort_by_size"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:forceQueryable="true"
        tools:replace="android:icon,android:label,android:theme">

        <!-- 模块入口通过 META-INF/xposed/java_init.list 声明（libxposed 102），
             不再使用 legacy 的 xposedmodule meta-data / assets/xposed_init。 -->

        <!-- ===== 设置入口 =====
             用 NoActionBar 主题：页面自带顶部应用栏（标题 + 版本），
             去掉系统 ActionBar 避免和页面里的标题重复。 -->
        <!-- 新的设置界面（Compose 版，作为启动入口） -->
        <activity
            android:name=".ui.MainComposeActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 旧版设置页（XML + AppCompat）：暂时保留，后续清理时删除 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ui.GroupManageActivity"
            android:exported="true" />
        <activity
            android:name=".ui.ThemeActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".ui.SortGroupsActivity"
            android:exported="true" />
        <activity
            android:name=".ui.SignatureActivity"
            android:exported="false" />

        <!-- 跨进程数据桥：让微信能读取本模块在私有存储里的分组/签名 -->
        <provider
            android:name=".core.GroupProvider"
            android:authorities="io.github.wxgroup.reborn.groups"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
